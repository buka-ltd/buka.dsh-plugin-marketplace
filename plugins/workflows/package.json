{
  "name": "@buka/dsh-plugin-workflows",
  "version": "2.0.0",
  "description": "持久工作流 + 作业看板：岗位图约束任务流转，看板按任务分发与认领。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs"
  ],
  "engines": {
    "node": ">=22.20",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
