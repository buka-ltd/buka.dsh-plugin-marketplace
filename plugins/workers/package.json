{
  "name": "@buka/dsh-plugin-workers",
  "version": "1.1.0",
  "description": "在侧边栏管理打工人：每个打工人有不可变标识符、可选展示名、AGENTS.md 与项目 skills；智能体跑 DSH 会话，机器人是固定程序（v1 内建 clock）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs"
  ],
  "engines": {
    "node": ">=22.20",
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
