{
  "name": "@buka/dsh-plugin-skill-update-check",
  "version": "0.1.0",
  "description": "检查当前工作区的项目技能是否有上游更新，在新建会话输入框下方统计行的最右侧（上下文用量圆环之后）用 warn 色提示；点击弹出更新弹窗，可逐个或全部更新。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs"
  ],
  "engines": {
    "node": ">=22.20",
    "dsh": ">=0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "skills": "1.9.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
