{
  "name": "@buka/dsh-plugin-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件市场：校验插件 bundle 并生成/发布 format 1 索引",
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node scripts/build.ts",
    "build:code": "node scripts/build-code.ts",
    "build:clients": "node scripts/build-clients.ts",
    "check": "node scripts/check.ts",
    "serve": "node scripts/serve.ts",
    "test": "node --test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pretest": "node scripts/build-code.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@buka/plugin-kit": "workspace:*",
    "@buka/plugin-ui": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-dockkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
